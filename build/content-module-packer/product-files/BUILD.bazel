load("@rules_go//go:def.bzl", "go_binary", "go_test")

# A binary of its own: a platform set runs it once per platform, and a change of the collector must not re-key it.
go_binary(
    name = "product-files",
    srcs = [
        "json.go",
        "main.go",
        "render.go",
    ],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "jetbrains.com/content-module-packer/product-files",
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "product-files_test",
    srcs = [
        "json.go",
        "main.go",
        "render.go",
        "render_test.go",
    ],
    data = glob(["testdata/**"]),
    pure = "on",
)
