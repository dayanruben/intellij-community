load("@rules_go//go:def.bzl", "go_binary", "go_test")

# Hand-maintained: no gazelle target is wired up in this repository, so adding a `.go` file means editing `srcs` here.

go_binary(
    name = "dev-dist-composer",
    srcs = [
        "compose.go",
        "json.go",
        "layout.go",
        "main.go",
        "manifest.go",
        "paths.go",
        "realpath_other.go",
        "realpath_windows.go",
        "spec.go",
    ],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "jetbrains.com/content-module-packer/dev-dist-composer",
    pure = "on",
    visibility = ["//visibility:public"],
    deps = [
        "//build/content-module-packer/internal/filemetadata",
        "//build/content-module-packer/internal/span",
        "@com_github_zeebo_xxh3//:xxh3",
        "@org_golang_x_text//cases",
        "@org_golang_x_text//language",
        "@org_golang_x_text//unicode/norm",
    ],
)

