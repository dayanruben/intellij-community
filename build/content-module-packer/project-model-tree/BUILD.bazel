load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "project-model-tree",
    srcs = ["main.go"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "jetbrains.com/content-module-packer/project-model-tree",
    pure = "on",
    visibility = ["//visibility:public"],
    deps = ["//build/content-module-packer/internal/span"],
)

go_test(
    name = "project-model-tree_test",
    srcs = [
        "main.go",
        "main_test.go",
    ],
    pure = "on",
    deps = ["//build/content-module-packer/internal/span"],
)
